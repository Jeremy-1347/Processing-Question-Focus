    !!subject_col := as.factor(.data[[subject_col]]),\
    !!rt_col := as.numeric(.data[[rt_col]])\
  )\
\
# \uc0\u21435 \u38500  NA / \u38750 \u27491  RT\
data_clean <- data %>%\
  filter(!is.na(.data[[rt_col]]), .data[[rt_col]] > 0)\
\
# ======================================================\
